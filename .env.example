# ---- Site ----
PITO_SITE_URL=https://pito-three.vercel.app
# Secret for the 10-minute cron (Vercel sends it as Bearer). Any long random string.
CRON_SECRET=

# ---- Ethereum ----
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/VOTRE_CLE

# ---- Supabase (service_role, serveur uniquement) ----
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Claude (plans + agent "via Pito") ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- RunPod (GPU pods: un ordinateur par token, et Rent) ----
RUNPOD_API_KEY=

# ---- Argent ----
# Tresorerie ETH. Vide = mode gratuit : chaque machine a PITO_FREE_HOURS d'ordinateur a vos frais.
PITO_TREASURY=
PITO_FREE_HOURS=2
# Marge Pito sur le prix GPU (en %)
PITO_MARGIN_PCT=20
# Exiger le launch stamp Programmable et que le signataire soit le launch wallet
PITO_REQUIRE_PROGRAMMABLE=true

# ---- Originals / Open Models (optionnel) : endpoint OpenAI-compatible (Ollama, vLLM) sur une machine Pito ----
PITO_HOUSE_MODEL_URL=
PITO_HOUSE_MODEL_NAME=qwen2.5-coder:14b
