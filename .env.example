# ---- Ethereum ----
# Un RPC Ethereum mainnet (Alchemy, Infura, QuickNode...). Obligatoire.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/VOTRE_CLE

# ---- Supabase ----
SUPABASE_URL=https://xxxx.supabase.co
# Cle "service_role" (Project Settings > API). Reste cote serveur, jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Claude (plans de construction) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- RunPod (GPU) ----
RUNPOD_API_KEY=
# ID de l'endpoint Serverless cree a partir du dossier worker/
RUNPOD_ENDPOINT_ID=

# ---- Financement des runs GPU (optionnel) ----
# Si PITO_TREASURY est rempli, chaque run coute PITO_RUN_PRICE_ETH, paye en ETH a cette adresse.
# S'il est vide, chaque machine a PITO_FREE_RUNS_PER_DAY runs gratuits par 24 h (a vos frais).
PITO_TREASURY=
PITO_RUN_PRICE_ETH=0.005
PITO_FREE_RUNS_PER_DAY=1

# Exiger que le token ait ete lance via Programmable et que le signataire soit le wallet de lancement
PITO_REQUIRE_PROGRAMMABLE=true
